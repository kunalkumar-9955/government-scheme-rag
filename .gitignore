# ============================================================
# Root .gitignore for Government Scheme RAG
# Covers: Django Backend, Next.js Frontend, Docker, Python & OS
# ============================================================

# ── 1. Environment & Secrets (NEVER COMMIT REAL CREDENTIALS) ──
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Allow explicitly tracked environment template examples
!.env.example
!.env.*.example
!.env.production.example
!backend/.env.example
!frontend/.env.example

# Certificates, Keys, Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets.json
service-account*.json

# ── 2. Python & Django ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Django Media, Static Collections & Local Database
backend/media/
backend/staticfiles/
backend/static_collected/
media/
staticfiles/
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Django Local Config overrides
local_settings.py
backend/config/settings/local.py

# ── 3. Python Virtual Environments ──
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# ── 4. Node.js & Next.js Frontend ──
node_modules/
*/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Static Outputs
.next/
*/.next/
frontend/.next/
out/
frontend/out/
frontend/build/
.vercel/

# TypeScript build info & generated types
*.tsbuildinfo
frontend/next-env.d.ts

# ── 5. Testing & Coverage ──
coverage/
*/coverage/
frontend/coverage/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ── 6. Logs & Debugging ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
celerybeat-schedule
celerybeat.pid

# ── 7. Docker & Local Data Persistence ──
postgres_data/
pgdata/
redis_data/
minio_data/

# ── 8. IDE, Editors & OS Files ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
*.backup
*_backup.*
*generator_backup*

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
