# ============================================================
# Government Scheme AI Assistant — Production Environment Template
# Copy to .env and provide real credentials before deployment.
# NEVER commit real production secrets to git.
# ============================================================

# ── Environment & Core ──
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_SECRET_KEY
ALLOWED_HOSTS=localhost,127.0.0.1,govscheme.nic.in,api.govscheme.nic.in,backend,nginx
CSRF_TRUSTED_ORIGINS=https://govscheme.nic.in,https://api.govscheme.nic.in

# ── PostgreSQL Database ──
POSTGRES_DB=govscheme_db
POSTGRES_USER=govscheme_app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# ── Redis Cache & Broker ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT Authentication ──
JWT_SIGNING_KEY=CHANGE_ME_STRONG_JWT_SIGNING_KEY
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI & LLM Credentials ──
GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE
LLM_PRIMARY_MODEL=gemini-1.5-pro
LLM_FAST_MODEL=gemini-2.0-flash
LLM_EMBEDDING_MODEL=models/text-embedding-004
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ── RAG Hyperparameters ──
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_THRESHOLD=0.35
USE_RERANKER=True

# ── S3 / MinIO Object Storage (Optional for Cloud) ──
USE_S3=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=govscheme-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=ap-south-1

# ── Celery Flower Monitoring ──
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_FLOWER_PASSWORD

# ── Rate Limiting & Throttling ──
THROTTLE_ANON_RATE=120/minute
THROTTLE_USER_RATE=600/minute

# ── Sentry Error Tracking ──
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Frontend Environment (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_NAME=Government Scheme AI Assistant
NEXT_PUBLIC_APP_VERSION=1.0.0
