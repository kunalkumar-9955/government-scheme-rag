# ============================================================
# Government Scheme AI Assistant — Backend Environment
# Copy this file to .env and fill in your values
# ============================================================

# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── PostgreSQL ──
POSTGRES_DB=govscheme_db
POSTGRES_USER=govscheme_user
POSTGRES_PASSWORD=govscheme_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── JWT ──
JWT_SIGNING_KEY=your-jwt-signing-key-change-this

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Google AI ──
GOOGLE_API_KEY=your-google-api-key-here
LLM_PRIMARY_MODEL=gemini-1.5-pro
LLM_FAST_MODEL=gemini-2.0-flash-exp
LLM_EMBEDDING_MODEL=models/text-embedding-004

# ── OpenAI (optional fallback) ──
OPENAI_API_KEY=

# ── Cohere (optional reranker) ──
COHERE_API_KEY=

# ── RAG Settings ──
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_THRESHOLD=0.7
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=True

# ── LLM Settings ──
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ── MinIO / S3 Storage ──
USE_S3=False
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=govscheme-docs
MINIO_ENDPOINT_URL=http://minio:9000

# ── Email ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@govscheme.ai

# ── Sentry (production) ──
SENTRY_DSN=

# ── Django Log Level ──
DJANGO_LOG_LEVEL=DEBUG
